   1          #include "reg52.h"
   2          #include "Key.h"
   3          
   4          // 独立按键均为低电平按下
   5          sbit KEY1 = P3^1;
   6          sbit KEY2 = P3^0;
   7          sbit KEY3 = P3^2;
   8          sbit KEY4 = P3^3;
   9          
  10          static void delay_10us(unsigned int ten_us)
  11          {
  12   1          while (ten_us--);
  13   1      }
  14          
  15          unsigned char Key_Read(unsigned char mode)   //读取一次独立按键，返回被按下的按键编号
  16          {
  17   1          static unsigned char key = 1;
  18   1      
  19   1          if (mode)
  20   1          {
  21   2              key = 1;  //清除按键锁定状态，允许重新检测按键
  22   2          }
  23   1      
  24   1          if (key == 1 && (KEY1 == 0 || KEY2 == 0 || KEY3 == 0 || KEY4 == 0))
  25   1          {
  26   2              delay_10us(1000);  //延时约 10 ms，完成按键消抖
  27   2              key = 0;  //暂时锁定按键，防止按键被长按时重复触发
  28   2              if (KEY1 == 0)
  29   2                  return KEY1_PRESS;
  30   2              if (KEY2 == 0)
  31   2                  return KEY2_PRESS;
  32   2              if (KEY3 == 0)
  33   2                  return KEY3_PRESS;
  34   2              if (KEY4 == 0)
  35   2                  return KEY4_PRESS;
  36   2          }
  37   1          else if (KEY1 == 1 && KEY2 == 1 && KEY3 == 1 && KEY4 == 1)
  38   1          {
  39   2              key = 1;
  40   2          }
  41   1      
  42   1          return KEY_UNPRESS;
  43   1      }


