 280   2              return key;
 281   2          }
 282   1          if (key == 10)
 283   1          {
 284   2              return PHONE_KEY_DIGIT_ZERO;
 285   2          }
 286   1          if (key == 11)
 287   1          {
 288   2              return PHONE_KEY_BACKSPACE;
 289   2          }
 290   1          if (key == 12)
 291   1          {
 292   2              return PHONE_KEY_DELETE_CONFIRM;
 293   2          }
 294   1          if (key == 16)
 295   1          {
 296   2              return PHONE_KEY_DIAL;
 297   2          }
 298   1          return PHONE_KEY_NONE;
 299   1      }
