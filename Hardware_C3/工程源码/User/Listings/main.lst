 248          static void Comm_Proc(void)  //执行串口通信状态机并根据 PC 回复推进救援流程
 249          {
 250   1          unsigned char rx;
 251   1      
 252   1          // 一次处理当前缓冲区中的全部字节，避免连续中文回复滞留在接收缓冲区
 253   1          while (Uart_ReadByte(&rx))
 254   1          {
 255   2              // 通信状态：等待“报告位置” -> 发送“01” -> 等待“收到” -> 启动救援
 256   2              if (Comm_State == COMM_WAIT_POS)
 257   2              {
 258   3                  if (Comm_MatchByte(rx, MsgReportPos))
 259   3                  {
 260   4                      Comm_State = COMM_WAIT_OK;
 261   4                      Comm_MatchIndex = 0;
 262   4                      Uart_SendBytes(MsgPos01);
 263   4                  }
 264   3              }
 265   2              else if (Comm_State == COMM_WAIT_OK)
 266   2              {
 267   3                  if (Comm_MatchByte(rx, MsgReceived))
 268   3                  {
 269   4                      Rescue_Start();
 270   4                  }
 271   3              }
 272   2          }
 273   1      }
