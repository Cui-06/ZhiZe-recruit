 218   2              {
 219   3                  upper = 0x00;
 220   3                  lower = 0x00;
 221   3              }
 222   2              else
 223   2              {
 224   3                  upper = OLED_GetTextColumn((unsigned int)text_col, 0);
 225   3                  lower = OLED_GetTextColumn((unsigned int)text_col, 1);
 226   3              }
 227   2      
 228   2              OLED_IIC_WriteByte(upper);
 229   2              OLED_IIC_WriteByte(lower);
 230   2          }
 231   1          OLED_DataStreamEnd();
 232   1      
